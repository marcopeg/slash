---
import Layout from '../../layouts/Layout.astro';
import { getTrackBySlug, getTrackSlugs } from '../../lib/tracks';

export async function getStaticPaths() {
  return getTrackSlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const track = getTrackBySlug(slug);
---

<Layout>
  {track && (
    <div>
      <h2>{track.title}</h2>
      {track.thumbnail && (
        <img
          class="track-thumbnail"
          src={track.thumbnail}
          alt={`Thumbnail for ${track.title}`}
          loading="lazy"
        />
      )}
      <p>{track.description}</p>
      {track.tags.length > 0 && (
        <ul class="track-tags">
          {track.tags.map(tag => (
            <li class="track-tag">{tag}</li>
          ))}
        </ul>
      )}
      <p>Track slug: {slug}</p>
      <p>[Audio player coming soon]</p>
      <a href="/">← Back to tracks</a>
    </div>
  )}
  {!track && (
    <div>
      <h2>Track not found</h2>
      <a href="/">← Back to tracks</a>
    </div>
  )}
</Layout>
