---
import Layout from '../../layouts/Layout.astro';
import { getTrackBySlug, getPlayableTrackSlugs } from '../../lib/tracks';

export async function getStaticPaths() {
  return getPlayableTrackSlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const track = getTrackBySlug(slug);

if (!track) {
  Astro.response.status = 404;
}
---

<Layout>
  {track && (
    <div class="track-detail-grid">
      <div class="track-media">
        {track.hasVideo ? (
          <video controls src={track.video} class="track-player">
            Your browser does not support the video tag.
          </video>
        ) : (
          // audio-only (or no video) — show thumbnail and place audio player under it
          track.thumbnail ? (
            <div class="thumbnail-audio">
              <img class="track-player" src={track.thumbnail} alt={`Thumbnail for ${track.title}`} />
              {track.hasAudio && (
                <audio controls src={track.audio} class="track-player audio-player">
                  Your browser does not support the audio element.
                </audio>
              )}
            </div>
          ) : (
            // no thumbnail but audio available — show audio player alone
            track.hasAudio ? (
              <audio controls src={track.audio} class="track-player audio-player">
                Your browser does not support the audio element.
              </audio>
            ) : null
          )
        )}
      </div>

      <details class="track-details" open>
        <summary>
          <span>Track details</span>
        </summary>
        <div class="track-info">
          <h2>{track.title}</h2>
          {/* Thumbnail and audio moved to left column when no video; do not duplicate thumbnail when video exists */}
          <p>{track.description}</p>
          {track.tags.length > 0 && (
            <ul class="track-tags">
              {track.tags.map(tag => (
                <li class="track-tag">{tag}</li>
              ))}
            </ul>
          )}
          <p>Track slug: {slug}</p>
          <a href="/">← Back to tracks</a>
        </div>
      </details>
    </div>
  )}
  {!track && (
    <div>
      <h2>Track not found</h2>
      <a href="/">← Back to tracks</a>
    </div>
  )}
</Layout>

<script is:inline>
  const details = document.querySelector('.track-details');
  if (details && window.matchMedia('(max-width: 700px)').matches) {
    details.open = false;
  }
</script>
