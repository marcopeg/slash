---
import Layout from '../../layouts/Layout.astro';
import { getTrackBySlug, getPlayableTrackSlugs } from '../../lib/tracks';

export async function getStaticPaths() {
  return getPlayableTrackSlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const track = getTrackBySlug(slug);

if (!track) {
  Astro.response.status = 404;
}
---

<Layout>
  {track && (
    <div class="track-grid">
      <div class="track-media">
        {track.hasVideo ? (
          <video controls src={track.video} class="track-player">
            Your browser does not support the video tag.
          </video>
        ) : track.hasAudio ? (
          <audio controls src={track.audio} class="track-player">
            Your browser does not support the audio element.
          </audio>
        ) : null}
      </div>

      <div class="track-info">
        <h2>{track.title}</h2>
        {track.thumbnail && (
          <img
            class="track-thumbnail"
            src={track.thumbnail}
            alt={`Thumbnail for ${track.title}`}
            loading="lazy"
          />
        )}
        <p>{track.description}</p>
        {track.tags.length > 0 && (
          <ul class="track-tags">
            {track.tags.map(tag => (
              <li class="track-tag">{tag}</li>
            ))}
          </ul>
        )}
        <p>Track slug: {slug}</p>
        <a href="/">← Back to tracks</a>
      </div>
    </div>
  )}
  {!track && (
    <div>
      <h2>Track not found</h2>
      <a href="/">← Back to tracks</a>
    </div>
  )}
</Layout>
