---
import Layout from '../layouts/Layout.astro';
import { getTrackSummaries } from '../lib/tracks';

export const layout = Layout;
const tracks = getTrackSummaries();
---

<Layout>
  <h2>🎵 Find Your Track And Play</h2>
  <ul class="track-list">
    {tracks.map(track => (
      <li class="track-card">
        {track.thumbnail && (
          <img
            class="track-thumbnail"
            src={track.thumbnail}
            alt={`Thumbnail for ${track.title}`}
            loading="lazy"
          />
        )}
        <div class="track-details">
          <a href={`/track/${track.slug}`}>{track.title}</a>
          <p class="track-description">{track.description}</p>
          <ul class="track-tags">
            {track.tags.map(tag => (
              <li class="track-tag">{tag}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ul>
</Layout>
