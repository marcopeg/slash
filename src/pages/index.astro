---
import Layout from '../layouts/Layout.astro';
export const layout = Layout;
const tracks = [
	{ slug: 'blues_100_g', title: 'Blues in G (100bpm)' },
	{ slug: 'rock-cool-Am-100-1m', title: 'Rock Cool in Am (100bpm, 1m)' },
	{ slug: 'little_wing_68_em', title: 'Little Wing in Em (68bpm)' },
];
---

<Layout>
	<h2>🎵 Find Your Track And Play</h2>
	<ul>
		{tracks.map(track => (
			<li>
				<span style="font-size:1.5em; margin-right:0.5em;">🎶</span>
				<a href={`/track/${track.slug}`}>{track.title}</a>
			</li>
		))}
	</ul>
</Layout>
