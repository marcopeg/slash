---
import Layout from '../layouts/Layout.astro';
import { getTrackSummaries } from '../lib/tracks';

export const layout = Layout;
const tracks = getTrackSummaries();
---

<Layout>
  <ul class="track-grid">
    {tracks.map(track => (
      <li class="track-item">
        <a class="track-link" href={`/track/${track.slug}`}>
          {track.thumbnail && (
            <span
              class="track-thumbnail"
              role="img"
              aria-label={`Thumbnail for ${track.title}`}
              style={`background-image: url(${track.thumbnail});`}
            />
          )}
          <span class="track-title">{track.title}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
